          </constraints>
          <rules>
            <rule id="9004-c95b-5c00-ac57" name="Legiones Thallaxes" hidden="false">
              <description>An army that includes one or models with this special ruke may take up to three Thallax Cohorts as a non-Compulsory Elites choice in the same detachment as the model with this special rule - these units may not select a Dedicated Transport of any kind. Any models in a Thallax Cohort which are included in an army due to this special rule gain the same Legiones Astartes (X) special rile as the Legion Forge Lord it shares a Detachment with, but may not select any Legion specific Wargear or other options.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="9bae-9bea-d391-a8f6" name="Battlesmith (X)" hidden="false" targetId="5d57-4d02-1e36-4a82" type="rule">
